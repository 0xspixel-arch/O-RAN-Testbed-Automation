# O-RAN Unified Monitoring Environment Variables

# RMR Configuration
RMR_RTG_SVC=routemgr:4561
RMR_SRC_ID=monitoring-instance
RMR_SEED_RT=
RMR_RTREQ_FREQ=5

# API Keys and Authentication
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
HERE_API_KEY=your_here_api_key
ORAN_AUTH_TOKEN=your_oran_auth_token
PROBE_API_KEY=your_probe_api_key
ERICSSON_API_TOKEN=your_ericsson_api_token

# Service Endpoints
RIC_ENDPOINT=ws://ric:8080/ric
XAPP_ENDPOINT_1=http://xapp1:8081/api/v1/metrics
XAPP_ENDPOINT_2=http://xapp2:8082/api/v1/metrics
E2_ENDPOINT=ws://e2:8083/e2
PROBE_ENDPOINT=http://probe:9000/api/probe

# Application Configuration
NODE_ENV=production
CONFIG_PATH=config/production.yaml
PORT=3000

# Vendor Configuration
VENDOR_NAME=ericsson
VENDOR_ENDPOINT=https://api.ericsson.com/v1/telemetry